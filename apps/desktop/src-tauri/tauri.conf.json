{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Harness",
  "version": "0.2.0",
  "identifier": "com.nexusharness.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nexus",
    "copyright": "Nexus-Harness",
    "category": "DeveloperTool",
    "shortDescription": "Harness de ingenieria autonomo con el protocolo Nexus",
    "longDescription": "Nexus Harness: chat agentico, gate determinista (lint Nexus, ley de 400, tests), skills inyectadas en RAM y auto-relevo de sesiones. El motor corre como proceso aparte y se apaga con la ventana.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/nexus-harness-engine.exe": "engine/nexus-harness-engine.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
